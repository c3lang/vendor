extern fn int cursor_get(MdbCursor cursor, MdbVal* key, MdbVal* data, MdbCursorOp operation) @cname("mdb_cursor_get");
extern fn int cursor_put(MdbCursor cursor, MdbVal* key, MdbVal* data, MdbWriteFlags flags) @cname("mdb_cursor_put");
