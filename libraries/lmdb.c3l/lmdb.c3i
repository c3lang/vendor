extern fn int reader_list(MdbEnv env, MdbMsgFunc callback, void* context) @cname("mdb_reader_list");
extern fn int reader_check(MdbEnv env, int* dead) @cname("mdb_reader_check");

extern fn void* modload(ZString file, ZString symbol, MdbCryptoFuncs** functions, ZString* error) @cname("mdb_modload");
extern fn void modunload(void* handle) @cname("mdb_modunload");
extern fn void modsetup(MdbEnv env, MdbCryptoFuncs* functions, ZString passphrase) @cname("mdb_modsetup");

macro lmdb::MdbVal String.to_mdbval(&self)
{
	return { .size = self.len, .data = self.ptr };
}
