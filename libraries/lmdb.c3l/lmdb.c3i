extern fn int set_relfunc(MdbTxn transaction, MdbDbi database, MdbRelFunc relocate) @cname("mdb_set_relfunc");
extern fn int set_relctx(MdbTxn transaction, MdbDbi database, void* context) @cname("mdb_set_relctx");

extern fn int get(MdbTxn transaction, MdbDbi database, MdbVal* key, MdbVal* data) @cname("mdb_get");
extern fn int put(MdbTxn transaction, MdbDbi database, MdbVal* key, MdbVal* data, MdbWriteFlags flags) @cname("mdb_put");
