<*
	Tracy bindings. Converted from:
	https://github.com/wolfpld/tracy/blob/cae9bf0bef7968c36c5fd254cf89b08596dd45e6/public/tracy/TracyC.h
*>
module tracy;

const ON_DEMAND @weak = false;
const MANUAL_LIFETIME @weak = false;
const FIBER @weak = false;

constdef TracyPlotFormatEnum : inline int
{
    NUMBER,
    MEMORY,
    PERCENTAGE,
    WATT,
}

constdef TracyMessageSeverity : inline ichar
{
    TRACE,
    DEBUG,
    INFO,
    WARNING,
    ERROR,
    FATAL,
}

module std::core::env;
const bool TRACY_DISABLE = $feat(TRACY_DISABLE);

module tracy @feat(!TRACY_DISABLE) @link(!$feat(TRACY_DISABLE), "TracyClient");
import std::collections::list, std::collections::map;
import std::thread;

extern fn void ___tracy_set_thread_name(ZString name) @builtin;

struct TracySourceLocationData
{
    ZString name;
    ZString function;
    ZString file;
    uint line;
    uint color;
}

struct TracyCZoneContext
{
    uint id;
    int active;
    ulong connectionId @feat(ON_DEMAND);
}

struct TracyGpuTimeData
{
    long gpuTime;
    ushort queryId;
    char context;
}

struct TracyGpuZoneBeginData
{
    ulong srcloc;
    ushort queryId;
    char context;
}

struct TracyGpuZoneBeginCallstackData
{
    ulong srcloc;
    int depth;
    ushort queryId;
    char context;
}

struct TracyGpuZoneEndData
{
    ushort queryId;
    char context;
}

struct TracyGpuNewContextData
{
    long gpuTime;
    float period;
    char context;
    char flags;
    char type;
}

struct TracyGpuContextNameData
{
    char context;
    ZString name;
    ushort len;
}

struct TracyGpuCalibrationData
{
    long gpuTime;
    long cpuDelta;
    char context;
}

struct TracyGpuTimeSyncData
{
    long gpuTime;
    char context;
}

alias TracyLockableContextData = void;
alias TracySharedLockableContextData = void;

alias TracyCZoneCtx = TracyCZoneContext;

alias TracyCLockCtx = TracyLockableContextData*;
alias TracyCSharedLockCtx = TracySharedLockableContextData*;

extern fn void ___tracy_startup_profiler() @builtin @feat(MANUAL_LIFETIME);
extern fn void ___tracy_shutdown_profiler() @builtin @feat(MANUAL_LIFETIME);
extern fn int ___tracy_profiler_started() @builtin @feat(MANUAL_LIFETIME);

extern fn ulong ___tracy_alloc_srcloc(uint line, ZString source, sz sourceSz, ZString function, sz functionSz, uint color) @builtin;
extern fn ulong ___tracy_alloc_srcloc_name(uint line, ZString source, sz sourceSz, ZString function, sz functionSz, ZString name, sz nameSz, uint color) @builtin;

extern fn TracyCZoneCtx ___tracy_emit_zone_begin(TracySourceLocationData* srcloc, int active) @builtin;
extern fn TracyCZoneCtx ___tracy_emit_zone_begin_callstack(TracySourceLocationData* srcloc, int depth, int active) @builtin;
extern fn TracyCZoneCtx ___tracy_emit_zone_begin_alloc(ulong srcloc, int active) @builtin;
extern fn TracyCZoneCtx ___tracy_emit_zone_begin_alloc_callstack(ulong srcloc, int depth, int active) @builtin;
extern fn void ___tracy_emit_zone_end(TracyCZoneCtx ctx) @builtin;
extern fn void ___tracy_emit_zone_text(TracyCZoneCtx ctx, ZString txt, sz size) @builtin;
extern fn void ___tracy_emit_zone_text_fmt(TracyCZoneCtx ctx, ZString fmt, ...) @builtin;
extern fn void ___tracy_emit_zone_name(TracyCZoneCtx ctx, ZString txt, sz size) @builtin;
extern fn void ___tracy_emit_zone_name_fmt(TracyCZoneCtx ctx, ZString fmt, ...) @builtin;
extern fn void ___tracy_emit_zone_color(TracyCZoneCtx ctx, uint color) @builtin;
extern fn void ___tracy_emit_zone_value(TracyCZoneCtx ctx, ulong value) @builtin;

extern fn void ___tracy_emit_gpu_zone_begin(TracyGpuZoneBeginData) @builtin;
extern fn void ___tracy_emit_gpu_zone_begin_callstack(TracyGpuZoneBeginCallstackData) @builtin;
extern fn void ___tracy_emit_gpu_zone_begin_alloc(TracyGpuZoneBeginData) @builtin;
extern fn void ___tracy_emit_gpu_zone_begin_alloc_callstack(TracyGpuZoneBeginCallstackData) @builtin;
extern fn void ___tracy_emit_gpu_zone_end(TracyGpuZoneEndData) @builtin;
extern fn void ___tracy_emit_gpu_time(TracyGpuTimeData) @builtin;
extern fn void ___tracy_emit_gpu_new_context(TracyGpuNewContextData) @builtin;
extern fn void ___tracy_emit_gpu_context_name(TracyGpuContextNameData) @builtin;
extern fn void ___tracy_emit_gpu_calibration(TracyGpuCalibrationData) @builtin;
extern fn void ___tracy_emit_gpu_time_sync(TracyGpuTimeSyncData) @builtin;

extern fn void ___tracy_emit_gpu_zone_begin_serial(TracyGpuZoneBeginData) @builtin;
extern fn void ___tracy_emit_gpu_zone_begin_callstack_serial(TracyGpuZoneBeginCallstackData) @builtin;
extern fn void ___tracy_emit_gpu_zone_begin_alloc_serial(TracyGpuZoneBeginData) @builtin;
extern fn void ___tracy_emit_gpu_zone_begin_alloc_callstack_serial(TracyGpuZoneBeginCallstackData) @builtin;
extern fn void ___tracy_emit_gpu_zone_end_serial(TracyGpuZoneEndData) @builtin;
extern fn void ___tracy_emit_gpu_time_serial(TracyGpuTimeData) @builtin;
extern fn void ___tracy_emit_gpu_new_context_serial(TracyGpuNewContextData) @builtin;
extern fn void ___tracy_emit_gpu_context_name_serial(TracyGpuContextNameData) @builtin;
extern fn void ___tracy_emit_gpu_calibration_serial(TracyGpuCalibrationData) @builtin;
extern fn void ___tracy_emit_gpu_time_sync_serial(TracyGpuTimeSyncData) @builtin;

extern fn int ___tracy_connected() @builtin;

extern fn void ___tracy_emit_memory_alloc(void* ptr, sz size) @builtin;
extern fn void ___tracy_emit_memory_alloc_callstack(void* ptr, sz size, int depth) @builtin;
extern fn void ___tracy_emit_memory_free(void* ptr) @builtin;
extern fn void ___tracy_emit_memory_free_callstack(void* ptr, int depth) @builtin;
extern fn void ___tracy_emit_memory_alloc_named(void* ptr, sz size, ZString name) @builtin;
extern fn void ___tracy_emit_memory_alloc_callstack_named(void* ptr, sz size, int depth, ZString name) @builtin;
extern fn void ___tracy_emit_memory_free_named(void* ptr, ZString name) @builtin;
extern fn void ___tracy_emit_memory_free_callstack_named(void* ptr, int depth, ZString name) @builtin;
extern fn void ___tracy_emit_memory_discard(ZString name) @builtin;
extern fn void ___tracy_emit_memory_discard_callstack(ZString name, int depth) @builtin;

extern fn void ___tracy_emit_logString(ichar severity, int color, int callstack_depth, sz size, ZString txt) @builtin;
extern fn void ___tracy_emit_logStringL(ichar severity, int color, int callstack_depth, ZString txt) @builtin;

extern fn void ___tracy_emit_frame_mark(ZString name) @builtin;
extern fn void ___tracy_emit_frame_mark_start(ZString name) @builtin;
extern fn void ___tracy_emit_frame_mark_end(ZString name) @builtin;
extern fn void ___tracy_emit_frame_image(void* image, ushort w, ushort h, char offset, int flip) @builtin;

extern fn void ___tracy_emit_plot(ZString name, double val) @builtin;
extern fn void ___tracy_emit_plot_float(ZString name, float val) @builtin;
extern fn void ___tracy_emit_plot_int(ZString name, long val) @builtin;
extern fn void ___tracy_emit_plot_config(ZString name, int type, int step, int fill, uint color) @builtin;
extern fn void ___tracy_emit_message_appinfo(ZString txt, sz size) @builtin;

extern fn TracyLockableContextData* ___tracy_announce_lockable_ctx(TracySourceLocationData* srcloc) @builtin;
extern fn void ___tracy_terminate_lockable_ctx(TracyLockableContextData* lockdata) @builtin;
extern fn int ___tracy_before_lock_lockable_ctx(TracyLockableContextData* lockdata) @builtin;
extern fn void ___tracy_after_lock_lockable_ctx(TracyLockableContextData* lockdata) @builtin;
extern fn void ___tracy_after_unlock_lockable_ctx(TracyLockableContextData* lockdata) @builtin;
extern fn void ___tracy_after_try_lock_lockable_ctx(TracyLockableContextData* lockdata, int acquired) @builtin;
extern fn void ___tracy_mark_lockable_ctx(TracyLockableContextData* lockdata, TracySourceLocationData* srcloc) @builtin;
extern fn void ___tracy_custom_name_lockable_ctx(TracyLockableContextData* lockdata, ZString name, sz nameSz) @builtin;

extern fn TracySharedLockableContextData* ___tracy_announce_shared_lockable_ctx(TracySourceLocationData* srcloc) @builtin;
extern fn void ___tracy_terminate_shared_lockable_ctx(TracySharedLockableContextData* lockdata) @builtin;
extern fn int ___tracy_before_lock_shared_lockable_ctx(TracySharedLockableContextData* lockdata) @builtin;
extern fn void ___tracy_after_lock_shared_lockable_ctx(TracySharedLockableContextData* lockdata) @builtin;
extern fn void ___tracy_after_unlock_shared_lockable_ctx(TracySharedLockableContextData* lockdata) @builtin;
extern fn void ___tracy_after_try_lock_shared_lockable_ctx(TracySharedLockableContextData* lockdata, int acquired) @builtin;
extern fn int ___tracy_before_lock_shared_shared_lockable_ctx(TracySharedLockableContextData* lockdata) @builtin;
extern fn void ___tracy_after_lock_shared_shared_lockable_ctx(TracySharedLockableContextData* lockdata) @builtin;
extern fn void ___tracy_after_unlock_shared_shared_lockable_ctx(TracySharedLockableContextData* lockdata) @builtin;
extern fn void ___tracy_after_try_lock_shared_shared_lockable_ctx(TracySharedLockableContextData* lockdata, int acquired) @builtin;
extern fn void ___tracy_mark_shared_lockable_ctx(TracySharedLockableContextData* lockdata, TracySourceLocationData* srcloc) @builtin;
extern fn void ___tracy_custom_name_shared_lockable_ctx(TracySharedLockableContextData* lockdata, ZString name, sz nameSz) @builtin;

