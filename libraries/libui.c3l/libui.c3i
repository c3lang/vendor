alias UiTable = void*;
alias UiTableSelection = void*;
alias UiCallback = fn void(void* data);
alias UiCallbackI = fn int(void* data);
alias UiControlCallback = fn void(UiControl sender, void *senderData);
alias UiWindowCallback = fn void(UiWindow sender, void *senderData);
alias UiWindowCallbackI = fn int(UiWindow sender, void *senderData);
alias UiButtonCallback = fn void(UiButton sender, void *senderData);
alias UiBoxCallback = fn void(UiBox sender, void *senderData);
alias UiCheckboxCallback = fn void(UiCheckbox sender, void *senderData);
alias UiEntryCallback = fn void(UiEntry sender, void *senderData);
alias UiLabelCallback = fn void(UiLabel sender, void *senderData);
