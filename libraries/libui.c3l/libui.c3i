// libui.c3i
// C3 bindings for libui-ng
// https://github.com/libui-ng/libui-ng
// https://libui-ng.github.io/libui-ng

module libui;


// Types
struct UiInitOptions
{
  usz size;
}
struct UiTime
{
  int tm_sec;
  int tm_min;
  int tm_hour;
  int tm_mday;
  int tm_mon;
  int tm_year;
  int tm_wday;
  int tm_yday;
  int tm_isdst;
}
alias UiControl = void*;
alias UiWindow = void*;
alias UiButton = void*;
alias UiBox = void*;
alias UiCheckbox = void*;
