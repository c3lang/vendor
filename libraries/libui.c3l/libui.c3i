alias UiMenuItemCallback = fn void(UiMenuItem sender, void *senderData);
alias UiMenuItemCallbackW = fn void(UiMenuItem sender, UiWindow window, void *senderData);
alias UiMenuCallback = fn void(UiMenu sender, void *senderData);
alias UiAreaCallback = fn void(UiArea sender, void *senderData);
alias UiAreaHandlerCallback = fn void(UiAreaHandler sender, void *senderData);
alias UiAreaDrawParamsCallback = fn void(UiAreaDrawParams sender, void *senderData);
alias UiAreaMouseEventCallback = fn void(UiAreaMouseEvent sender, void *senderData);
alias UiAreaKeyEventCallback = fn void(UiAreaKeyEvent sender, void *senderData);
alias UiDrawContextCallback = fn void(UiDrawContext sender, void *senderData);
alias UiDrawPathCallback = fn void(UiDrawPath sender, void *senderData);
alias UiDrawBrushCallback = fn void(UiDrawBrush sender, void *senderData);
alias UiDrawStrokeParamsCallback = fn void(UiDrawStrokeParams sender, void *senderData);
alias UiDrawMatrixCallback = fn void(UiDrawMatrix sender, void *senderData);
alias UiDrawBrushGradientStopCallback = fn void(UiDrawBrushGradientStop sender, void *senderData);
alias UiAttributeCallback = fn void(UiAttribute sender, void *senderData);
alias UiOpenTypeFeaturesCallback = fn void(UiOpenTypeFeatures sender, void *senderData);
alias UiAttributedStringCallback = fn void(UiAttributedString sender, void *senderData);
alias UiAttributedStringForEachAttributeFunc = fn UiForEach(UiAttributedString sender, UiAttribute a, sz start, sz end, void *data);
alias UiFontDescriptorCallback = fn void(UiFontDescriptor sender, void *senderData);
alias UiDrawTextLayoutCallback = fn void(UiDrawTextLayout sender, void *senderData);
alias UiDrawTextLayoutParamsCallback = fn void(UiDrawTextLayoutParams sender, void *senderData);
alias UiFontButtonCallback = fn void(UiFontButton sender, void *senderData);
alias UiColorButtonCallback = fn void(UiColorButton sender, void *senderData);
