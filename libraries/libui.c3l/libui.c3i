alias UiTableModelCallback = fn void(UiTableModel sender, void *senderData);
alias UiTableModelHandlerCallback = fn void(UiTableModelHandler sender, void *senderData);
alias UiTableTextColumnOptionalParamsCallback = fn void(UiTableTextColumnOptionalParams sender, void *senderData);
alias UiTableParamsCallback = fn void(UiTableParams sender, void *senderData);
alias UiTableCallback = fn void(UiTable sender, void *senderData);
alias UiTableCallbackR = fn void(UiTable sender, int row, void *senderData);
alias UiTableCallbackC = fn void(UiTable sender, int column, void *senderData);
alias UiTableSelectionCallback = fn void(UiTableSelection sender, void *senderData);

